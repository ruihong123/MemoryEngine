{
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.suggestSnippets": false,
    "C_Cpp.enhancedColorization": "disabled",
    "C_Cpp.intelliSenseEngineFailureRecovery": "disabled",
    "C_Cpp.workspaceSymbols": "disabled",
    "C_Cpp.includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/include",
        "${workspaceFolder}/storage",
        "${workspaceFolder}/utils",
        "${workspaceFolder}/txn",
        "${workspaceFolder}/tpcc",
        "${workspaceFolder}/bench",
        "${workspaceFolder}/port",
        "${workspaceFolder}/btr",
        "${workspaceFolder}/memory_node",
        "${workspaceFolder}/Rtree"
    ],
    "C_Cpp.defines": [
        "ROCKSDB_SUPPORT_THREAD_LOCAL",
        "MVOCC",
        "BACKOFF",
        "BOOST_ALLOW_DEPRECATED_HEADERS"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.compilerPath": "/usr/bin/gcc",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    "files.associations": {
        "*.h": "c",
        "*.hpp": "cpp",
        "*.cc": "cpp",
        "*.cpp": "cpp"
    },
    "cmake.buildArgs": [
        "-j",
        "8"
    ],
    "cmake.buildParallelJobs": 8,
    "cmake.generator": "Unix Makefiles",
    "cmake.configureArgs": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_BUILD_TYPE=Debug"
    ],
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.sourceDirectory": "${workspaceFolder}",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": true,
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: LLVM, IndentWidth: 4, ColumnLimit: 120 }",
    "clangd.arguments": [
        "--header-insertion=never",
        "--completion-style=detailed",
        "--function-arg-placeholders=false",
        "--background-index=false",
        "--clang-tidy=false",
        "--all-scopes-completion=true",
        "--pch-storage=memory",
        "--log=error",
        "-j=2"
    ],
    "clangd.path": "clangd",
    "clangd.checkUpdates": false
}